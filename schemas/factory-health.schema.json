{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.standards/schemas/factory-health.schema.json",
  "title": "Factory Health",
  "description": "Health signals and dependency status for a tenant at certification time.",
  "type": "object",
  "required": [
    "protocol",
    "protocolVersion",
    "generatedAt",
    "tenantId",
    "status",
    "signals"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "const": "factory.certification.v1"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["healthy", "degraded", "unhealthy", "unknown"]
    },
    "signals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["ok", "warn", "error", "unknown"]
          },
          "value": {},
          "message": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["build", "test", "runtime", "dependency", "config", "other"]
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "required", "status"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "required": { "type": "boolean" },
          "status": {
            "type": "string",
            "enum": ["available", "unavailable", "optional-missing", "unknown"]
          },
          "version": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
