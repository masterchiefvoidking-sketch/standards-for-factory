{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.standards/schemas/factory-audit.schema.json",
  "title": "Factory Audit",
  "description": "Structured audit results from the Tenant Certification Protocol.",
  "type": "object",
  "required": [
    "protocol",
    "protocolVersion",
    "generatedAt",
    "tenantId",
    "auditId",
    "status",
    "summary",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "type": "string",
      "const": "factory.certification.v1"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "tenantId": {
      "type": "string"
    },
    "auditId": {
      "type": "string",
      "description": "Unique audit run identifier"
    },
    "status": {
      "type": "string",
      "enum": ["pass", "fail", "partial", "pending"]
    },
    "summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "skipped", "warnings"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "title", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "category": {
            "type": "string",
            "enum": [
              "structure",
              "security",
              "integration",
              "documentation",
              "schema",
              "health",
              "qualification",
              "other"
            ]
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "skip", "warn"]
          },
          "evidence": { "type": "string" },
          "remediation": { "type": "string" },
          "repairPriority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 = highest priority per REPAIR_ORDER"
          }
        }
      }
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": { "type": "string" },
        "version": { "type": "string" },
        "operator": { "type": "string" }
      }
    }
  }
}
